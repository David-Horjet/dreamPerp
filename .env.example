# Testnet-only key. With OWNER_ADDRESS set, this is a bot key linked to that account
# (app → wallet → Link a bot → Perps) and it only needs STT for gas.
# Leave OWNER_ADDRESS blank to trade this key's own account instead.
PRIVATE_KEY=0x
OWNER_ADDRESS=
PERP_SYMBOL=ETH-PERP
PERP_SIDE=long
PERP_NOTIONAL_USDSO=20
DRY_RUN=true
